# Contact form — get a free key at https://resend.com
RESEND_API_KEY=

# Where enquiries should land (defaults to the site email in lib/site.ts)
CONTACT_TO_EMAIL=

# Must be a verified domain in Resend, e.g. "FareO'Clock <hello@budgetbanda.com>"
CONTACT_FROM_EMAIL=

# Hero map — MapTiler wins by default when its key is set, then Mapbox,
# then the keyless OpenFreeMap fallback.
# MapTiler keys: https://cloud.maptiler.com/account/keys/ (restrict by domain)
NEXT_PUBLIC_MAPTILER_KEY=
# Mapbox tokens: https://account.mapbox.com/access-tokens/ (restrict by URL)
NEXT_PUBLIC_MAPBOX_TOKEN=
